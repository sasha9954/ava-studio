AVA_ENV=development
AVA_APP_NAME=ava-studio
AVA_SECRET_KEY=change-this-secret-before-server
AVA_STORAGE_DIR=storage
AVA_STATIC_DIR=static
AVA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
AVA_PUBLIC_BASE_URL=http://127.0.0.1:8000
# Optional: needed for ASR translation to Russian
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
# LTX / Comfy remote video generation
COMFY_BASE_URL=http://100.80.135.114:8000
COMFY_IMAGE_VIDEO_WORKFLOW=app/workflows/image-video.json
COMFY_OUTPUT_HANDOFF_STRATEGY=backend_proxy
COMFY_UPLOAD_CONNECT_TIMEOUT_SEC=20
COMFY_UPLOAD_READ_TIMEOUT_SEC=180
COMFY_UPLOAD_MAX_ATTEMPTS=4
COMFY_PROMPT_CONNECT_TIMEOUT_SEC=20
COMFY_PROMPT_READ_TIMEOUT_SEC=180
COMFY_POLL_INTERVAL_SEC=2
COMFY_POLL_TIMEOUT_SEC=900
VIDEO_PROVIDER_DEFAULT=comfy_remote

# ComfyUI endpoints for ava-studio Board/LTX
# Main LTX ComfyUI server:
#   cd /d C:\AI\ComfyUI_srv
#   call .venv\Scripts\activate
#   python main.py --listen 0.0.0.0 --port 8000 --user-directory C:\AI\ComfyUI_srv_user
COMFY_MAIN_BASE_URL=http://100.80.135.114:8000
COMFY_LTX_BASE_URL=http://100.80.135.114:8000
COMFY_BASE_URL=http://100.80.135.114:8000

# MMAudio / Comfy lab UI:
#   cd /d C:\AI\ComfyUI_lab
#   call .venv\Scripts\activate
#   python main.py --listen 0.0.0.0 --port 8001 --user-directory C:\AI\ComfyUI_lab_user --enable-manager
COMFY_MMAUDIO_BASE_URL=http://100.80.135.114:8001
COMFY_LAB_BASE_URL=http://100.80.135.114:8001

# Generation tariffs:
# ia2v/lip-sync = 2 credits
# first-last    = 2 credits
# i2v/other     = 1 credit
# mmaudio       = 1 credit

# ComfyUI endpoints for ava-studio Board/LTX
COMFY_LAB_URL=http://100.80.135.114:8001
